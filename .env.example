# Copiar este archivo a ".env" y completar con valores reales.
# El archivo ".env" real ya está excluido en .gitignore.

# =========================================================
# Portal EOR (elFinder / plugin WP File Manager)
# =========================================================

# URL base del portal público del EOR.
EOR_BASE_URL=https://www.enteoperador.org/

# Prefijo del volumen usado por elFinder para calcular el hash de descarga
# (confirmado mediante ingeniería inversa contra el portal real).
EOR_VOLUME_ID=l1

# Folder ID (fid) de la carpeta "Predespacho" (cubre desde 2019-01-01 hasta hoy).
EOR_FID_RECIENTE=97

# Folder ID (fid) de la carpeta "Histórico" (cubre 2013-01-01 a 2019-04-09).
EOR_FID_HISTORICO=454

# Fecha de corte entre ambas carpetas. Fechas >= a esta usan EOR_FID_RECIENTE;
# fechas anteriores usan EOR_FID_HISTORICO.
EOR_FID_CUTOFF_DATE=2019-01-01

# Prefijo del nombre de archivo del reporte, ej. PUB004-PRE-20260904.zip
EOR_REPORT_PREFIX=PUB004-PRE

# Timeout (segundos) para las peticiones HTTP al portal.
EOR_REQUEST_TIMEOUT=30

# Códigos de país válidos del MER, separados por coma (sin espacios).
# OSO001=Guatemala, OSO002=El Salvador, OSO003=Honduras, OSO004=Nicaragua,
# OSO005=Costa Rica, OSO006=Panamá.
EOR_COUNTRY_CODES=OSO001,OSO002,OSO003,OSO004,OSO005,OSO006

# Número de fila (0-based) donde inicia el encabezado real dentro de cada
# hoja del Excel (hay un bloque de membrete antes de los datos reales).
# Confirmado contra un archivo real del portal: fila 8 visible en Excel = índice 7.
EOR_HEADER_ROW=7

# =========================================================
# PostgreSQL (capa Gold)
# =========================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=predespacho
DB_USER=postgres
DB_PASSWORD=changeme

# =========================================================
# Rutas locales (capas del medallón) y logging
# =========================================================
BRONZE_PATH=./data/bronze
SILVER_PATH=./data/silver
LOG_PATH=./logs/pipeline.log
